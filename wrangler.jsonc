{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "baseball-manager",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USERS",
        "class_name": "UserStore"
      }
    ]
  },
  "exports": {
    "UserStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}

